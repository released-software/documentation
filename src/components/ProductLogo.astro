---
import { getSpace, type SpaceId } from '../data/spaces';

interface Props {
  space: SpaceId;
  size?: 16 | 20 | 24 | 32;
  decorative?: boolean;
}

const { space, size = 20, decorative = false } = Astro.props;
const label = getSpace(space).shortName;
---

<svg
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={decorative ? undefined : label}
  fill="none"
  height={size}
  role={decorative ? undefined : 'img'}
  viewBox="0 0 24 24"
  width={size}
  xmlns="http://www.w3.org/2000/svg"
>
  {
    space === 'hub' && (
      <path d="M4 4h7v7H4V4Zm9 9h7v7h-7v-7ZM4 13h7v7H4v-7Zm9-9h7v7h-7V4Z" fill="currentColor" />
    )
  }
  {
    space === 'betterboard' && (
      <path d="M4 4h16v4H4V4Zm0 6h10v4H4v-4Zm0 6h16v4H4v-4Zm12-6h4v4h-4v-4Z" fill="currentColor" />
    )
  }
  {
    space === 'partners' && (
      <path d="m9.4 14.6-1.7 1.7a3 3 0 0 1-4.2-4.2l3.4-3.4a3 3 0 0 1 4.2 0m2.9.7 1.7-1.7a3 3 0 0 1 4.2 4.2l-3.4 3.4a3 3 0 0 1-4.2 0M8.5 15.5l7-7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
    )
  }
</svg>
