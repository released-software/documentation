---
interface Props {
  question: string;
}

const { question } = Astro.props;

if (!question.trim()) {
  throw new Error('FaqItem requires a question');
}
---

<details class="faq-item" data-faq-item>
  <summary data-faq-question>{question}</summary>
  <div class="faq-item__answer" data-faq-answer>
    <slot />
  </div>
</details>

<style>
  .faq-item {
    margin: 0;
    border: 0;
    border-block-end: 1px solid var(--released-line);
    padding: 0;
  }

  .faq-item > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    padding-block: 1rem;
    padding-inline: 0 0.5rem;
    color: var(--released-ink);
    cursor: pointer;
    font-weight: 500;
    line-height: 1.4;
    list-style: none;
  }

  .faq-item > summary::marker,
  .faq-item > summary::-webkit-details-marker,
  .faq-item > summary::before {
    display: none;
    content: none;
  }

  .faq-item > summary::after {
    content: '⌄';
    flex: none;
    color: var(--released-ink-muted);
    font-size: 1.125rem;
    line-height: 1;
    transform: rotate(-90deg);
    transition: transform 160ms ease;
  }

  .faq-item[open] > summary {
    margin-bottom: 0;
  }

  .faq-item[open] > summary::after {
    transform: rotate(0deg);
  }

  .faq-item > summary:focus-visible {
    outline: 1px solid var(--released-ink);
    outline-offset: 3px;
  }

  .faq-item__answer {
    padding-bottom: 1.25rem;
  }

  .faq-item__answer :global(> :first-child) {
    margin-top: 0;
  }

  .faq-item__answer :global(> :last-child) {
    margin-bottom: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item > summary::after {
      transition-duration: 0s;
    }
  }
</style>
