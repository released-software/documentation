---
interface Props {
  type?: 'note' | 'tip' | 'caution' | 'danger';
  title?: string;
}

const { type = 'note', title } = Astro.props;
const calloutTitle = title?.trim();
---

<aside
  class:list={['neutral-callout', calloutTitle && 'neutral-callout--titled']}
  data-neutral-callout
  data-callout-type={type}
  role={type === 'caution' || type === 'danger' ? 'alert' : 'note'}
>
  <svg
    aria-hidden="true"
    class="neutral-callout__icon"
    data-callout-icon
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width="1.75"
  >
    {
      type === 'note' && (
        <>
          <circle cx="12" cy="12" r="9" />
          <path d="M12 11v5" />
          <path d="M12 8h.01" />
        </>
      )
    }
    {
      type === 'tip' && (
        <>
          <path d="M9 18h6" />
          <path d="M10 22h4" />
          <path d="M8.2 14.4a7 7 0 1 1 7.6 0c-.7.5-.8 1-.8 1.6H9c0-.6-.1-1.1-.8-1.6Z" />
        </>
      )
    }
    {
      type === 'caution' && (
        <>
          <path d="M10.3 4.1 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 4.1a2 2 0 0 0-3.4 0Z" />
          <path d="M12 9v4" />
          <path d="M12 17h.01" />
        </>
      )
    }
    {
      type === 'danger' && (
        <>
          <path d="m8.5 3-5.5 5.5v7L8.5 21h7l5.5-5.5v-7L15.5 3h-7Z" />
          <path d="M12 8v5" />
          <path d="M12 17h.01" />
        </>
      )
    }
  </svg>
  {calloutTitle && <div class="neutral-callout__title" data-callout-title>{calloutTitle}</div>}
  <div class="neutral-callout__content" data-callout-content>
    <slot />
  </div>
</aside>

<style>
  .neutral-callout {
    --callout-tone: var(--released-callout-note);
    display: grid;
    grid-template-columns: 1.05rem minmax(0, 1fr);
    column-gap: 0.625rem;
    margin-block: 1.5rem;
    padding: 1rem 1.125rem;
    border: 1px solid
      color-mix(in srgb, var(--callout-tone) 16%, var(--released-line));
    border-radius: var(--released-radius-md);
    color: var(--released-ink-soft);
    background: color-mix(
      in srgb,
      var(--callout-tone) 7%,
      var(--released-bg-raised)
    );
  }

  .neutral-callout[data-callout-type='tip'] {
    --callout-tone: var(--released-callout-tip);
  }

  .neutral-callout[data-callout-type='caution'] {
    --callout-tone: var(--released-callout-caution);
  }

  .neutral-callout[data-callout-type='danger'] {
    --callout-tone: var(--released-callout-danger);
  }

  .neutral-callout__title {
    grid-column: 2;
    grid-row: 1;
    margin: 0;
    color: var(--released-ink);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    line-height: 1.4;
  }

  .neutral-callout__icon {
    width: 1.05rem;
    height: 1.05rem;
    grid-column: 1;
    grid-row: 1;
    margin-top: 0.1rem;
    color: var(--callout-tone);
  }

  .neutral-callout:not(.neutral-callout--titled) .neutral-callout__icon {
    margin-top: 0.325rem;
  }

  .neutral-callout__content {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
    margin: 0;
  }

  .neutral-callout--titled {
    row-gap: 0.65rem;
  }

  .neutral-callout--titled .neutral-callout__content {
    grid-row: 2;
  }

  .neutral-callout__content :global(> :first-child) {
    margin-top: 0;
  }

  .neutral-callout__content :global(> :last-child) {
    margin-bottom: 0;
  }
</style>
