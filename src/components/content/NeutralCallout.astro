---
interface Props {
  type?: 'note' | 'tip' | 'caution' | 'danger';
  title?: string;
}

const { type = 'note', title } = Astro.props;
const labels = {
  note: 'Note',
  tip: 'Tip',
  caution: 'Caution',
  danger: 'Danger'
} as const;
const label = title?.trim() || labels[type];

if (!label) {
  throw new Error(`NeutralCallout received an unsupported type: "${type}"`);
}
---

<aside
  class="neutral-callout"
  data-neutral-callout
  data-callout-type={type}
  role={type === 'caution' || type === 'danger' ? 'alert' : 'note'}
>
  <div class="neutral-callout__label" data-callout-label>
    <svg
      aria-hidden="true"
      class="neutral-callout__icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="1.75"
    >
      {
        type === 'note' && (
          <>
            <circle cx="12" cy="12" r="9" />
            <path d="M12 11v5" />
            <path d="M12 8h.01" />
          </>
        )
      }
      {
        type === 'tip' && (
          <>
            <path d="M9 18h6" />
            <path d="M10 22h4" />
            <path d="M8.2 14.4a7 7 0 1 1 7.6 0c-.7.5-.8 1-.8 1.6H9c0-.6-.1-1.1-.8-1.6Z" />
          </>
        )
      }
      {
        type === 'caution' && (
          <>
            <path d="M10.3 4.1 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 4.1a2 2 0 0 0-3.4 0Z" />
            <path d="M12 9v4" />
            <path d="M12 17h.01" />
          </>
        )
      }
      {
        type === 'danger' && (
          <>
            <path d="m8.5 3-5.5 5.5v7L8.5 21h7l5.5-5.5v-7L15.5 3h-7Z" />
            <path d="M12 8v5" />
            <path d="M12 17h.01" />
          </>
        )
      }
    </svg>
    <span>{label}</span>
  </div>
  <div class="neutral-callout__content">
    <slot />
  </div>
</aside>

<style>
  .neutral-callout {
    display: grid;
    gap: 0.65rem;
    margin-block: 1.5rem;
    padding: 1rem 1.125rem;
    border: 1px solid var(--released-line);
    border-radius: var(--released-radius-md);
    color: var(--released-ink-soft);
    background: var(--released-bg-raised);
  }

  .neutral-callout__label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--released-ink);
    background-color: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    line-height: 1.3;
  }

  .neutral-callout__icon {
    width: 1.05rem;
    height: 1.05rem;
    flex: none;
  }

  .neutral-callout__content {
    min-width: 0;
  }

  .neutral-callout__content :global(> :first-child) {
    margin-top: 0;
  }

  .neutral-callout__content :global(> :last-child) {
    margin-bottom: 0;
  }
</style>
