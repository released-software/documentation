---
interface Props {
  src: string;
  title: string;
  provider: 'youtube' | 'loom';
  aspectRatio?: `${number}/${number}`;
}

import { normalizeResponsiveEmbed } from './responsive-embed.mjs';

const { src, title, provider, aspectRatio = '16/9' } = Astro.props;
const normalized = normalizeResponsiveEmbed({
  src,
  title,
  provider,
  aspectRatio
});
---

<div
  class="responsive-embed"
  data-responsive-embed
  data-embed-provider={provider}
  style={`--responsive-embed-ratio: ${normalized.aspectRatio};`}
>
  <iframe
    src={normalized.embedSrc}
    title={normalized.title}
    loading="lazy"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen
    referrerpolicy="strict-origin-when-cross-origin"
  ></iframe>
</div>

<style>
  .responsive-embed {
    width: 100%;
    max-width: 100%;
    margin-block: 1.75rem;
    overflow: hidden;
    aspect-ratio: var(--responsive-embed-ratio);
    border: 1px solid var(--released-line);
    border-radius: var(--released-radius-md);
    background: var(--released-bg-raised);
  }

  .responsive-embed iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
