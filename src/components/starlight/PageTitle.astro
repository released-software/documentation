---
import Default from '@astrojs/starlight/components/PageTitle.astro';

import {
  isAgentDocument,
  markdownPathForEntryId
} from '../../data/agent-docs.mjs';

const { entry } = Astro.locals.starlightRoute;
const showActions = isAgentDocument(entry);
const markdownPath = markdownPathForEntryId(entry.id);
---

<div class="page-title-row" data-page-title-row>
  <Default><slot /></Default>

  {
    showActions && (
      <page-markdown-actions
        data-markdown-url={markdownPath}
        data-page-actions
      >
        <div aria-label="Page Markdown actions" class="page-actions__group" role="group">
          <button
            aria-label="Copy page as Markdown"
            class="page-actions__action"
            data-copy-page
            data-tooltip="Copy page as Markdown"
            type="button"
          >
            <svg
              aria-hidden="true"
              fill="none"
              viewBox="0 0 20 20"
            >
              <rect
                height="11"
                rx="2"
                stroke="currentColor"
                stroke-width="1.5"
                width="9"
                x="7"
                y="3"
              />
              <path
                d="M5 6H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-1"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-width="1.5"
              />
            </svg>
          </button>
          <a
            aria-label="View page as Markdown"
            class="page-actions__action"
            data-tooltip="View page as Markdown"
            data-view-markdown
            href={markdownPath}
            rel="noopener"
            target="_blank"
          >
            <svg
              aria-hidden="true"
              fill="none"
              viewBox="0 0 20 20"
            >
              <rect
                height="12"
                rx="2"
                stroke="currentColor"
                stroke-width="1.5"
                width="16"
                x="2"
                y="4"
              />
              <path
                d="M5 12.5v-5l2.25 2.75L9.5 7.5v5"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
              />
              <path
                d="M12 9.5h3.5M13.75 8v4m0 0-1.5-1.5m1.5 1.5 1.5-1.5"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
              />
            </svg>
          </a>
        </div>

        <span
          aria-live="polite"
          class="visually-hidden"
          data-page-actions-status
        />
      </page-markdown-actions>
    )
  }
</div>

<script>
  class PageMarkdownActions extends HTMLElement {
    private copyButton?: HTMLButtonElement;
    private status?: HTMLElement;
    private resetTimer?: number;

    connectedCallback(): void {
      if (this.dataset.ready === 'true') return;
      this.dataset.ready = 'true';

      this.copyButton =
        this.querySelector<HTMLButtonElement>('[data-copy-page]') ?? undefined;
      this.status =
        this.querySelector<HTMLElement>('[data-page-actions-status]') ??
        undefined;

      this.copyButton?.addEventListener('click', this.copyPage);
    }

    disconnectedCallback(): void {
      this.copyButton?.removeEventListener('click', this.copyPage);
      if (this.resetTimer) window.clearTimeout(this.resetTimer);
    }

    private copyPage = async (): Promise<void> => {
      const markdownUrl = this.dataset.markdownUrl;
      if (!markdownUrl || !this.copyButton) return;

      this.copyButton.disabled = true;
      try {
        const response = await fetch(markdownUrl, {
          headers: { Accept: 'text/markdown' }
        });
        if (!response.ok) throw new Error(`Markdown request failed: ${response.status}`);

        await navigator.clipboard.writeText(await response.text());
        this.copyButton.dataset.tooltip = 'Copied as Markdown';
        if (this.status) this.status.textContent = 'Copied as Markdown.';
        if (this.resetTimer) window.clearTimeout(this.resetTimer);
        this.resetTimer = window.setTimeout(() => {
          if (this.copyButton) {
            this.copyButton.dataset.tooltip = 'Copy page as Markdown';
          }
        }, 2000);
      } catch {
        if (this.status) {
          this.status.textContent =
            'Could not copy this page. Use View as Markdown instead.';
        }
      } finally {
        this.copyButton.disabled = false;
      }
    };
  }

  if (!customElements.get('page-markdown-actions')) {
    customElements.define('page-markdown-actions', PageMarkdownActions);
  }
</script>

<style>
  .page-title-row {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .page-title-row > :global(h1#_top) {
    min-width: 0;
  }

  page-markdown-actions {
    position: relative;
    z-index: 2;
    flex: none;
    margin-top: 0.125rem;
  }

  .page-actions__group {
    display: flex;
    border: 1px solid var(--released-line-strong);
    border-radius: 0.625rem;
    background: var(--released-bg);
  }

  .page-actions__action {
    position: relative;
    display: inline-flex;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    align-items: center;
    justify-content: center;
    border: 0;
    color: var(--released-ink-muted);
    background: transparent;
    text-decoration: none;
    cursor: pointer;
  }

  .page-actions__action:first-child {
    border-radius: calc(0.625rem - 1px) 0 0 calc(0.625rem - 1px);
  }

  .page-actions__action:last-child {
    border-inline-start: 1px solid var(--released-line-strong);
    border-radius: 0 calc(0.625rem - 1px) calc(0.625rem - 1px) 0;
  }

  .page-actions__action:hover {
    color: var(--released-ink);
    background: var(--released-bg-raised);
  }

  .page-actions__action:disabled {
    cursor: wait;
  }

  .page-actions__action svg {
    width: 1rem;
    height: 1rem;
  }

  .page-actions__action::after {
    content: attr(data-tooltip);
    position: absolute;
    z-index: 3;
    inset-block-start: calc(100% + 0.55rem);
    inset-inline-end: 0;
    width: max-content;
    padding: 0.4rem 0.55rem;
    border-radius: var(--released-radius-sm);
    color: var(--released-bg);
    background: var(--released-ink);
    box-shadow: 0 8px 24px rgb(13 13 13 / 16%);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.125rem);
    transition:
      opacity 120ms ease,
      transform 120ms ease,
      visibility 120ms ease;
  }

  .page-actions__action:hover::after,
  .page-actions__action:focus-visible::after {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 40rem) {
    .page-title-row {
      flex-direction: column;
      gap: 0.875rem;
    }

    page-markdown-actions {
      margin-top: 0;
    }

    .page-actions__action::after {
      inset-inline: 0 auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-actions__action::after {
      transition: none;
    }
  }

  @media print {
    page-markdown-actions {
      display: none;
    }
  }
</style>
