---
import { Icon } from '@astrojs/starlight/components';

const accessibleLabel = Astro.locals.t('themeSelect.accessibleLabel');
const themes = [
  {
    icon: 'moon',
    label: Astro.locals.t('themeSelect.dark'),
    value: 'dark'
  },
  {
    icon: 'sun',
    label: Astro.locals.t('themeSelect.light'),
    value: 'light'
  },
  {
    icon: 'laptop',
    label: Astro.locals.t('themeSelect.auto'),
    value: 'auto'
  }
] as const;
---

<starlight-theme-select data-theme-picker>
  <div class="theme-menu">
    <button
      aria-expanded="false"
      aria-haspopup="menu"
      aria-label={`${accessibleLabel}. Current: ${themes[2].label}`}
      class="theme-trigger"
      data-theme-trigger
      type="button"
    >
      {
        themes.map(({ icon, value }) => (
          <span data-theme-trigger-icon={value} hidden={value !== 'auto'}>
            <Icon name={icon} />
          </span>
        ))
      }
      <span data-theme-current>{themes[2].label}</span>
      <Icon class="theme-caret" name="down-caret" />
    </button>

    <div class="theme-options" data-theme-options hidden role="menu">
      {
        themes.map(({ icon, label, value }) => (
          <button
            aria-checked={value === 'auto' ? 'true' : 'false'}
            data-theme-label={label}
            data-theme-option={value}
            role="menuitemradio"
            tabindex="-1"
            type="button"
          >
            <Icon name={icon} />
            <span>{label}</span>
            <svg
              aria-hidden="true"
              class="theme-check"
              data-theme-check
              fill="none"
              viewBox="0 0 16 16"
            >
              <path
                d="m3.25 8.25 3 3 6.5-6.5"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
              ></path>
            </svg>
          </button>
        ))
      }
    </div>
  </div>
</starlight-theme-select>

<script>
  type Theme = 'auto' | 'dark' | 'light';

  const storageKey = 'starlight-theme';
  const systemTheme = matchMedia('(prefers-color-scheme: light)');

  const parseTheme = (value: unknown): Theme =>
    value === 'dark' || value === 'light' || value === 'auto' ? value : 'auto';

  const loadTheme = (): Theme =>
    parseTheme(
      typeof localStorage === 'undefined'
        ? 'auto'
        : localStorage.getItem(storageKey)
    );

  const resolvedTheme = (theme: Theme): Exclude<Theme, 'auto'> =>
    theme === 'auto' ? (systemTheme.matches ? 'light' : 'dark') : theme;

  const storeTheme = (theme: Theme): void => {
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem(storageKey, theme === 'auto' ? '' : theme);
    }
  };

  class ReleasedThemeSelect extends HTMLElement {
    private trigger?: HTMLButtonElement;
    private menu?: HTMLElement;
    private options: HTMLButtonElement[] = [];
    private currentTheme: Theme = 'auto';

    connectedCallback(): void {
      if (this.dataset.themePickerReady === 'true') return;
      this.dataset.themePickerReady = 'true';

      this.trigger = this.querySelector<HTMLButtonElement>('[data-theme-trigger]') ?? undefined;
      this.menu = this.querySelector<HTMLElement>('[data-theme-options]') ?? undefined;
      this.options = Array.from(
        this.querySelectorAll<HTMLButtonElement>('[data-theme-option]')
      );

      this.trigger?.addEventListener('click', this.onTriggerClick);
      this.trigger?.addEventListener('keydown', this.onTriggerKeyDown);
      this.menu?.addEventListener('keydown', this.onMenuKeyDown);
      this.options.forEach((option) =>
        option.addEventListener('click', this.onOptionClick)
      );
      document.addEventListener('pointerdown', this.onOutsidePointerDown);

      this.update(loadTheme());
    }

    disconnectedCallback(): void {
      this.trigger?.removeEventListener('click', this.onTriggerClick);
      this.trigger?.removeEventListener('keydown', this.onTriggerKeyDown);
      this.menu?.removeEventListener('keydown', this.onMenuKeyDown);
      this.options.forEach((option) =>
        option.removeEventListener('click', this.onOptionClick)
      );
      document.removeEventListener('pointerdown', this.onOutsidePointerDown);
    }

    update(theme: Theme): void {
      this.currentTheme = theme;
      const activeOption = this.options.find(
        (option) => option.dataset.themeOption === theme
      );
      const label = activeOption?.dataset.themeLabel ?? 'Auto';

      this.querySelectorAll<HTMLElement>('[data-theme-trigger-icon]').forEach(
        (icon) => {
          icon.hidden = icon.dataset.themeTriggerIcon !== theme;
        }
      );
      const current = this.querySelector<HTMLElement>('[data-theme-current]');
      if (current) current.textContent = label;
      this.trigger?.setAttribute(
        'aria-label',
        `Select theme. Current: ${label}`
      );
      this.options.forEach((option) => {
        const selected = option === activeOption;
        option.setAttribute('aria-checked', String(selected));
        option
          .querySelector('[data-theme-check]')
          ?.toggleAttribute('hidden', !selected);
      });
    }

    private open(focus: 'current' | 'first' | 'last' = 'current'): void {
      if (!this.trigger || !this.menu) return;
      this.menu.hidden = false;
      this.trigger.setAttribute('aria-expanded', 'true');

      const currentIndex = Math.max(
        0,
        this.options.findIndex(
          (option) => option.dataset.themeOption === this.currentTheme
        )
      );
      const focusIndex =
        focus === 'first'
          ? 0
          : focus === 'last'
            ? this.options.length - 1
            : currentIndex;
      this.focusOption(focusIndex);
    }

    private close(restoreFocus = false): void {
      if (!this.trigger || !this.menu) return;
      this.menu.hidden = true;
      this.trigger.setAttribute('aria-expanded', 'false');
      this.options.forEach((option) => (option.tabIndex = -1));
      if (restoreFocus) this.trigger.focus();
    }

    private focusOption(index: number): void {
      if (!this.options.length) return;
      const wrappedIndex =
        (index + this.options.length) % this.options.length;
      this.options.forEach((option, optionIndex) => {
        option.tabIndex = optionIndex === wrappedIndex ? 0 : -1;
      });
      this.options[wrappedIndex]?.focus();
    }

    private select(theme: Theme): void {
      document.documentElement.dataset.theme = resolvedTheme(theme);
      storeTheme(theme);
      document
        .querySelectorAll<ReleasedThemeSelect>('starlight-theme-select')
        .forEach((picker) => picker.update(theme));
      this.close(true);
    }

    private onTriggerClick = (): void => {
      if (this.menu?.hidden) this.open();
      else this.close();
    };

    private onTriggerKeyDown = (event: KeyboardEvent): void => {
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      event.preventDefault();
      this.open(event.key === 'ArrowDown' ? 'first' : 'last');
    };

    private onMenuKeyDown = (event: KeyboardEvent): void => {
      const activeIndex = this.options.indexOf(
        document.activeElement as HTMLButtonElement
      );
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        this.focusOption(activeIndex + (event.key === 'ArrowDown' ? 1 : -1));
      } else if (event.key === 'Home' || event.key === 'End') {
        event.preventDefault();
        this.focusOption(event.key === 'Home' ? 0 : this.options.length - 1);
      } else if (event.key === 'Escape') {
        event.preventDefault();
        this.close(true);
      } else if (event.key === 'Tab') {
        this.close();
      }
    };

    private onOptionClick = (event: Event): void => {
      const option = event.currentTarget as HTMLButtonElement;
      this.select(parseTheme(option.dataset.themeOption));
    };

    private onOutsidePointerDown = (event: PointerEvent): void => {
      if (!event.composedPath().includes(this)) this.close();
    };
  }

  if (!customElements.get('starlight-theme-select')) {
    customElements.define('starlight-theme-select', ReleasedThemeSelect);
  }

  const updateForSystemTheme = (): void => {
    if (loadTheme() === 'auto') {
      document.documentElement.dataset.theme = resolvedTheme('auto');
    }
  };
  systemTheme.addEventListener('change', updateForSystemTheme);
</script>

<style>
  @layer starlight.components {
    starlight-theme-select {
      display: block;
      color: var(--released-ink-soft);
      font-size: var(--sl-text-sm);
    }

    .theme-menu {
      position: relative;
    }

    .theme-trigger,
    [data-theme-option] {
      border: 0;
      color: inherit;
      background: transparent;
      font: inherit;
      cursor: pointer;
    }

    .theme-trigger {
      display: flex;
      min-height: 2.25rem;
      align-items: center;
      gap: 0.375rem;
      padding-inline: 0.5rem;
      border-radius: 0.375rem;
    }

    .theme-trigger:hover,
    .theme-trigger[aria-expanded='true'] {
      color: var(--released-ink);
      background: var(--released-bg-card);
    }

    .theme-trigger :global(svg) {
      width: 0.875rem;
      height: 0.875rem;
    }

    [data-theme-trigger-icon] {
      display: flex;
    }

    [data-theme-trigger-icon][hidden] {
      display: none;
    }

    .theme-caret {
      width: 0.875rem;
      height: 0.875rem;
      margin-inline-start: 0.125rem;
      color: var(--released-ink-muted);
    }

    .theme-options {
      position: absolute;
      z-index: 20;
      inset-block-start: calc(100% + 0.375rem);
      inset-inline-end: 0;
      display: grid;
      width: 10rem;
      gap: 0.125rem;
      padding: 0.375rem;
      border: 1px solid var(--released-line);
      border-radius: var(--released-radius-sm);
      background: var(--released-bg);
      box-shadow: 0 10px 30px rgb(0 0 0 / 10%);
    }

    .theme-options[hidden] {
      display: none;
    }

    [data-theme-option] {
      display: grid;
      grid-template-columns: 1rem minmax(0, 1fr) 1rem;
      align-items: center;
      gap: 0.625rem;
      min-height: 2.25rem;
      padding-inline: 0.625rem;
      border-radius: 0.3rem;
      text-align: start;
    }

    [data-theme-option]:hover,
    [data-theme-option]:focus-visible {
      color: var(--released-ink);
      background: var(--released-bg-card);
    }

    [data-theme-option] :global(svg),
    .theme-check {
      width: 1rem;
      height: 1rem;
    }

    .theme-check {
      color: var(--released-ink);
    }

    .theme-check[hidden] {
      visibility: hidden;
    }

    .theme-trigger:focus-visible,
    [data-theme-option]:focus-visible {
      outline: 1px solid var(--released-ink);
      outline-offset: 2px;
    }

    :global(.mobile-preferences) .theme-options {
      inset-block: auto calc(100% + 0.375rem);
    }

    @media (prefers-reduced-motion: reduce) {
      .theme-trigger,
      [data-theme-option] {
        transition: none;
      }
    }
  }
</style>
