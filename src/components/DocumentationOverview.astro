---
import type { DocumentationSpace } from '../data/spaces';

interface Props {
  spaces: readonly DocumentationSpace[];
}

const { spaces } = Astro.props;
const audiences: Partial<Record<DocumentationSpace['id'], string>> = {
  betterboard: 'For Jira power users',
  hub: 'For teams communicating beyond Jira'
};
---

<section aria-label="Documentation spaces" class="documentation-overview">
  {
    spaces.map(
      (space) =>
        space.available && (
          <a
            class="documentation-card"
            data-documentation-space={space.id}
            href={space.href}
          >
            <span class="documentation-card__header">
              <span class="documentation-card__identity">
                <span class="documentation-card__audience">
                  {audiences[space.id] ?? 'Product documentation'}
                </span>
                <span class="documentation-card__title">{space.shortName}</span>
              </span>
              <span aria-hidden="true" class="documentation-card__arrow" data-card-arrow>↗</span>
            </span>
            <span class="documentation-card__description">{space.description}</span>
          </a>
        )
    )
  }
</section>

<style>
  .documentation-overview {
    display: grid;
    width: min(100%, 960px);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-inline: auto;
  }

  .documentation-card {
    display: grid;
    min-height: 280px;
    align-content: space-between;
    gap: 3rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--released-line);
    border-radius: var(--released-radius-lg);
    color: var(--released-ink);
    background: var(--released-bg-raised);
    text-decoration: none;
  }

  .documentation-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .documentation-card__identity {
    display: grid;
    gap: 0.55rem;
  }

  .documentation-card__audience {
    color: var(--released-ink-soft);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .documentation-card__title {
    font-size: clamp(2rem, 1.7rem + 1vw, 2.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .documentation-card__arrow {
    display: grid;
    width: 3.25rem;
    height: 3.25rem;
    flex: 0 0 auto;
    border: 1px solid var(--released-line);
    border-radius: var(--released-radius-pill);
    font-size: 1.75rem;
    line-height: 1;
    place-items: center;
    transition: transform 160ms ease;
  }

  .documentation-card__description {
    max-width: 31ch;
    color: var(--released-ink-muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  .documentation-card:hover .documentation-card__arrow {
    transform: translateX(4px);
  }

  .documentation-card:focus-visible {
    outline: 2px solid var(--released-ink);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .documentation-card__arrow {
      transition: none;
    }

    .documentation-card:hover .documentation-card__arrow {
      transform: none;
    }
  }

  @media (max-width: 35rem) {
    .documentation-overview {
      grid-template-columns: minmax(0, 1fr);
    }

    .documentation-card {
      min-height: 220px;
      gap: 2rem;
    }
  }
</style>
