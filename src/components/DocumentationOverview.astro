---
import type { DocumentationSpace } from '../data/spaces';

interface Props {
  spaces: readonly DocumentationSpace[];
}

const { spaces } = Astro.props;
const audiences: Partial<Record<DocumentationSpace['id'], string>> = {
  betterboard: 'For Jira power users',
  hub: 'For teams communicating beyond Jira'
};
const whatsNewHrefs: Partial<Record<DocumentationSpace['id'], string>> = {
  betterboard: 'https://released.so/betterboard/whats-new',
  hub: 'https://released.so/hub/whats-new'
};
---

<section aria-label="Documentation spaces" class="documentation-overview">
  {
    spaces.map(
      (space) =>
        space.available && (
          <article class="documentation-panel" data-documentation-space={space.id}>
            <div class="documentation-card">
              <div class="documentation-card__header">
                <div class="documentation-card__identity">
                  <span class="documentation-card__audience">
                    {audiences[space.id] ?? 'Product documentation'}
                  </span>
                  <h2 class="documentation-card__title">{space.shortName}</h2>
                </div>
              </div>
              <p class="documentation-card__description">{space.description}</p>
              <nav aria-label={`${space.shortName} actions`} class="documentation-card__actions">
                <a class="documentation-card__action documentation-card__action--primary" href={space.href}>
                  Documentation
                </a>
                {
                  whatsNewHrefs[space.id] && (
                    <a class="documentation-card__action" href={whatsNewHrefs[space.id]}>
                      What’s new
                    </a>
                  )
                }
              </nav>
            </div>
          </article>
        )
    )
  }
</section>

<style>
  .documentation-overview {
    display: grid;
    width: min(100%, 960px);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-inline: auto;
  }

  .documentation-panel {
    display: grid;
    min-height: 330px;
    padding: 42px;
    color: var(--released-ink);
    border-radius: 20px;
    background: var(--released-bg-raised);
  }

  .documentation-card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 2rem;
    min-height: 100%;
  }

  .documentation-card__header {
    display: block;
  }

  .documentation-card__identity {
    display: grid;
    gap: 0.55rem;
  }

  .documentation-card__audience {
    color: var(--released-ink-soft);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .documentation-card__title {
    margin: 0;
    font-size: clamp(2rem, 1.7rem + 1vw, 2.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .documentation-card__description {
    margin: 0;
    max-width: 31ch;
    color: var(--released-ink-muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  .documentation-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .documentation-card__action {
    border: 1px solid var(--released-line);
    border-radius: var(--released-radius-pill);
    padding: 0.75rem 1.25rem;
    color: var(--released-ink);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
  }

  .documentation-card__action--primary {
    border-color: var(--released-ink);
    background: var(--released-ink);
    color: var(--released-bg);
  }

  .documentation-card__action:focus-visible {
    outline: 2px solid var(--released-ink);
    outline-offset: 4px;
  }

  @media (max-width: 35rem) {
    .documentation-overview {
      grid-template-columns: minmax(0, 1fr);
    }

    .documentation-panel {
      min-height: 260px;
      padding: 1.75rem;
    }

    .documentation-card {
      gap: 2rem;
    }
  }
</style>
