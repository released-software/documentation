---
import type { DocumentationSpace } from '../data/spaces';
import ButtonLink from './ButtonLink.astro';

interface Props {
  spaces: readonly DocumentationSpace[];
}

const { spaces } = Astro.props;
const descriptions: Partial<Record<DocumentationSpace['id'], string>> = {
  betterboard: 'Set up a faster, more flexible Jira board and learn the workflows it improves.',
  hub: 'Learn how to share Jira work through roadmaps, release notes, and customer feedback.'
};
const whatsNewHrefs: Partial<Record<DocumentationSpace['id'], string>> = {
  betterboard: 'https://released.so/betterboard/whats-new',
  hub: 'https://released.so/hub/whats-new'
};
const overviewSpaces = spaces
  .filter((space) => space.available)
  .sort((left, right) => (left.id === 'betterboard' ? -1 : right.id === 'betterboard' ? 1 : 0));
---

<section aria-label="Documentation spaces" class="documentation-overview">
  {
    overviewSpaces.map((space) => (
      <article class="documentation-panel" data-documentation-space={space.id}>
        <div class="documentation-card">
          <h2 class="documentation-card__title">{space.shortName}</h2>
          <p class="documentation-card__description">{descriptions[space.id] ?? space.description}</p>
          <nav aria-label={`${space.shortName} actions`} class="documentation-card__actions">
            <ButtonLink href={space.href}>
              Documentation
            </ButtonLink>
            {
              whatsNewHrefs[space.id] && (
                <ButtonLink href={whatsNewHrefs[space.id]} variant="secondary">
                  What’s new
                </ButtonLink>
              )
            }
          </nav>
        </div>
      </article>
    ))
  }
</section>

<style>
  .documentation-overview {
    display: grid;
    width: min(100%, 1800px);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: minmax(0, 1fr);
    gap: 16px;
    margin-inline: auto;
  }

  .documentation-panel {
    display: grid;
    margin-block: 0;
    box-sizing: border-box;
    min-height: clamp(21.5rem, 24vw, 30rem);
    height: 100%;
    padding: clamp(2rem, 3vw, 3.5rem);
    color: var(--released-ink);
    border-radius: 20px;
    background: var(--released-bg-raised);
    transition:
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .documentation-panel:hover,
  .documentation-panel:focus-within {
    box-shadow: 0 18px 42px rgb(17 17 17 / 12%);
    transform: translateY(-4px);
  }

  .documentation-card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: clamp(1.5rem, 2.25vw, 2.5rem);
    min-height: 100%;
  }

  .documentation-panel .documentation-card__title {
    margin: 0;
    font-family: 'Switzer', var(--sl-font-system);
    font-size: clamp(2rem, 1.55rem + 0.85vw, 2.625rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .documentation-card__description {
    margin: 0;
    max-width: 32ch;
    color: var(--released-ink-muted);
    font-size: clamp(1rem, 0.9rem + 0.2vw, 1.125rem);
    line-height: 1.5;
    letter-spacing: -0.025em;
  }

  .documentation-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.75rem, 1vw, 1.25rem);
  }

  @media (max-width: 35rem) {
    .documentation-overview {
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: auto;
    }

    .documentation-panel {
      min-height: 22rem;
      height: 22rem;
      padding: 1.75rem;
    }

    .documentation-card {
      gap: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .documentation-panel {
      transition: none;
    }
  }
</style>
